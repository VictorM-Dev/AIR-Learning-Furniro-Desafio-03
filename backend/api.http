//Create for productCart
###
//ADICIONA UM PRODUTO AO USUÁRIO (ROTA PROTEGIDA)
POST {{baseUrl}}/productCart/add
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentCount": 1,
  "currentColor": "Black",
  "currentSize": "M",
  "productSlug": "refined-metal-0"
}

###
//ATUALIZA UM PRODUTO EXISTENTE (ROTA PROTEGIDA)
PUT {{baseUrl}}/productCart/update/refined-metal-0
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentCount": 2,
  "currentColor": "Red",
  "currentSize": "M",
  "productSlug": "refined-metal-0"
}

//REMOVE UM PRODUTO PELO ID DO PRODUTO (ROTA PROTEGIDA)
###
DELETE {{baseUrl}}/productCart/remove/refined-metal-0
Authorization: Bearer {{token}}

###
//REMOVE TODOS OS PRODUTOS DE TODOS OS USUÁRIOS (ROTA PROTEGIDA)
